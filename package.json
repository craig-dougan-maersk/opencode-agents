{
  "name": "opencode-agents",
  "version": "1.2.0",
  "description": "OpenCode plugin: install an orchestrator profile on an expensive model with cheap subagents for retrieval, mechanical edits and verification",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/craig-dougan-maersk/opencode-agents.git"
  },
  "homepage": "https://github.com/craig-dougan-maersk/opencode-agents#readme",
  "bugs": {
    "url": "https://github.com/craig-dougan-maersk/opencode-agents/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agents",
    "subagents",
    "orchestrator",
    "model-routing"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js",
    "./rpc": "./dist/rpc.js"
  },
  "files": [
    "dist",
    "agents",
    "commands",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "compile": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run compile && node test/run.js"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@opencode/theme": "^2.2.5",
    "@opentui/core": "^0.8.1",
    "@opentui/solid": "^0.8.1",
    "@types/node": "^22.0.0",
    "solid-js": "^1.9.18",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  }
}
